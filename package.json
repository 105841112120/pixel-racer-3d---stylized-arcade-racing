{
  "name": "pixel-racer-3d",
  "private": true,
  "version": "1.0.0",
  "description": "PIXEL RACER 3D - Offline Standalone Arcade Racing Game",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:dev": "vite build && electron electron/main.cjs",
    "electron:build": "vite build && electron-builder --win",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "android:build": "vite build && cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.pixelracer.app",
    "productName": "PIXEL RACER 3D",
    "copyright": "Copyright © 2026 Pixel Racer 3D",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "${productName}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PIXEL RACER 3D",
      "artifactName": "${productName} Setup.${ext}"
    },
    "portable": {
      "artifactName": "PIXEL RACER 3D.${ext}"
    }
  }
}
